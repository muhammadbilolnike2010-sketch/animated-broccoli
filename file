# --------------------------- test generatsiyasi -------------------------
def generate_test(grade: int, n: int = 10) -> list[Question]:
    """Berilgan sinf uchun n ta takrorlanmaydigan savol qaytaradi."""
    funcs = TOPICS[grade]
    questions: list[Question] = []
    seen: set[str] = set()
    for _ in range(500):
        if len(questions) >= n:
            break
        q = random.choice(funcs)()
        if q.text not in seen:
            seen.add(q.text)
            questions.append(q)
    return questions
