DERIVS = [("sin x", "cos x"), ("cos x", "-sin x"), ("eˣ", "eˣ"),
          ("ln x", "1/x"), ("tg x", "1/cos² x"), ("√x", "1/(2√x)")]
DERIV_POOL = ["cos x", "-sin x", "eˣ", "1/x", "1/cos² x", "1/(2√x)", "sin x", "-cos x"]
 
 
@topic(11)
def g11_derivative_formula():
    if random.random() < 0.5:
        f, d = random.choice(DERIVS)
        return build(f"f(x) = {f} bo'lsa, f'(x) = ?", d, [p for p in DERIV_POOL if p != d])
    a, n = random.randint(1, 6), random.randint(2, 6)
    wrong = [poly([(a * n, xp(n))]), poly([(a, xp(n - 1))]),
             poly([(a * (n - 1), xp(n - 1))]), poly([(a * n, xp(n - 2))])]
    return build(f"f(x) = {poly([(a, xp(n))])} bo'lsa, f'(x) = ?", poly([(a * n, xp(n - 1))]), wrong)
 
 
@topic(11)
def g11_derivative_value():
