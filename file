from __future__ import annotations
 
import random
from dataclasses import dataclass
from fractions import Fraction
 
 
@dataclass(frozen=True)
class Question:
    text: str
    options: list[str]
    correct: int  # to'g'ri javob indeksi
 
 
TOPICS: dict[int, list] = {g: [] for g in range(1, 12)}
 
 
def topic(grade: int):
    """Funksiyani berilgan sinf mavzulari ro'yxatiga qo'shadi."""
    def deco(func):
        TOPICS[grade].append(func)
        return func
    return deco
 
 
# ----------------------------- yordamchilar -----------------------------
_SUP = str.maketrans("0123456789-", "⁰¹²³⁴⁵⁶⁷⁸⁹⁻")
_SUB = str.maketrans("0123456789", "₀₁₂₃₄₅₆₇₈₉")
 
 
def sup(n) -> str:
    return str(n).translate(_SUP)
 
 
def sub(n) -> str:
    return str(n).translate(_SUB)
 
 
def xp(k: int) -> str:
    """x ning k-darajasi: '', 'x', 'x²', ..."""
    return "" if k == 0 else "x" if k == 1 else "x" + sup(k)
 
 
def fmt(x) -> str:
    if isinstance(x, Fraction):
        return str(x.numerator) if x.denominator == 1 else f"{x.numerator}/{x.denominator}"
    if isinstance(x, float):
        s = f"{round(x, 4):.4f}".rstrip("0").rstrip(".")
        return "0" if s in ("-0", "") else s.replace(".", ",")
    return str(x)
 
 
def poly(terms: list[tuple[int, str]]) -> str:
    """[(koeff, 'x²'), ...] -> '3x² - x + 5'"""
    out = ""
    for coef, var in terms:
        if coef == 0:
            continue
        mag = abs(coef)
        body = (str(mag) if (mag != 1 or not var) else "") + var
        if not out:
            out = ("-" if coef < 0 else "") + body
        else:
            out += f" {'-' if coef < 0 else '+'} {body}"
    return out or "0"
 
 
def pw(n: int) -> str:
    return f"({n})" if n < 0 else str(n)
 
 
def _nudge(c, negative: bool):
    if isinstance(c, Fraction):
        return c + Fraction(random.choice([-1, 1]) * random.randint(1, 3), c.denominator)
    if isinstance(c, float):
        return c + random.choice([-1, 1]) * random.randint(1, 9) / 10
    if isinstance(c, int):
        return c + random.choice([-1, 1]) * random.randint(1, 6)
    raise ValueError("Matnli javob uchun yetarli noto'g'ri variantlar berilmagan")
 
 
def build(text: str, correct, wrong: list, negative: bool = False) -> Question:
    """4 ta variantli savol yasaydi; to'g'ri javob o'rni tasodifiy."""
    right = fmt(correct)
    options: list[str] = []
    random.shuffle(wrong)
    for w in wrong:
        if not negative and isinstance(w, (int, float, Fraction)) and w < 0:
            continue
        s = fmt(w)
        if s != right and s not in options:
            options.append(s)
    options = options[:3]
    tries = 0
    while len(options) < 3:
        tries += 1
        if tries > 200:
            raise ValueError(f"Variant yetishmadi: {text}")
        v = _nudge(correct, negative)
        if not negative and v < 0:
            continue
        s = fmt(v)
        if s != right and s not in options:
            options.append(s)
    options.append(right)
    random.shuffle(options)
    return Question(text, options, options.index(right))
 
 
