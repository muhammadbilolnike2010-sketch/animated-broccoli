@topic(9)
def g9_inequality():
    a = random.choice([2, 3, 4, 5, 6, 7, -2, -3, -4, -5, -6])
    x0 = random.choice([i for i in range(-6, 9) if i])
    b = random.choice([i for i in range(-12, 13) if i])
    op = random.choice([">", "<"])
    c = a * x0 + b
 
    def flip(o):
        return "<" if o == ">" else ">"
    cop = op if a > 0 else flip(op)
    soft = {">": "≥", "<": "≤"}
    wrong = [f"x {flip(cop)} {x0}", f"x {cop} {-x0}", f"x {flip(cop)} {-x0}", f"x {soft[cop]} {x0}"]
    return build(f"Tengsizlikni yeching: {poly([(a, 'x'), (b, '')])} {op} {c}",
                 f"x {cop} {x0}", wrong)
 
 
