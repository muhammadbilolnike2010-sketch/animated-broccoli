    wrong = [a * x0 ** 3 + b * x0 ** 2 + c * x0, 3 * a * x0 ** 2 + 2 * b * x0,
             3 * a * x0 ** 2 + b * x0 + c, d + x0, d - x0]
    f = poly([(a, "x³"), (b, "x²"), (c, "x")])
