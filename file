@topic(11)
def g11_integral():
    n = random.randint(1, 3)
    m = random.randint(1, 4)
    k = (n + 1) * m
    if random.random() < 0.5:
        b = random.randint(1, 3)
        c = m * b ** (n + 1)
        wrong = [k * b ** (n + 1), m * b ** n, c + m, k * b ** n, c + b]
        return build(f"∫ {poly([(k, xp(n))])} dx integralni [0; {b}] kesmada hisoblang.", c, wrong)
    wrong = [poly([(k * (n + 1), xp(n + 1))]), poly([(m, xp(n))]), poly([(k, xp(n + 1))])]
    ans = poly([(m, xp(n + 1))]) + " + C"
    return build(f"∫ {poly([(k, xp(n))])} dx = ?", ans, [w + " + C" for w in wrong] + [ans.replace(" + C", "")])
 
 
@topic(11)
def g11_exponential():
    b, x, s = random.choice([2, 3, 5]), random.randint(1, 4), random.randint(1, 3)
    if random.random() < 0.5:
        text = f"{b}^x = {b ** x}"
        wrong = [b ** x, x + 1, x - 1, x * b]
    else:
        text = f"{b}^(x + {s}) = {b ** (x + s)}"
        wrong = [x + s, x - s, x + 1, x - 1]
    return build("Tenglamani yeching: " + text, x, wrong, negative=True)
 
 
@topic(11)
def g11_logarithmic():
    b, k = random.choice([2, 3, 5]), random.randint(2, 4)
